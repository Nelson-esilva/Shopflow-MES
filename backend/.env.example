# Django Settings
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# Postgres Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_ROOT_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# CORS
CORS_ALLOW_ALL_ORIGINS=True

# Mapeamento para Django
DB_NAME=${POSTGRES_DB}
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_HOST=${POSTGRES_HOST}
DB_PORT=${POSTGRES_PORT}

# Google OAuth (substitua pelos seus)
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# ClickHouse (porta 9000 na rede Docker; 9001 no host)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_USERNAME=clickhouse_server_user
CLICKHOUSE_PASSWORD=shopflow_password
CLICKHOUSE_DATABASE=production_data
