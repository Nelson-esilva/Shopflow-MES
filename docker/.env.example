# Django Settings
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# Postgres Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_ROOT_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# CORS
CORS_ALLOW_ALL_ORIGINS=True

# Mapeamento para Django
DB_NAME=${POSTGRES_DB}
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_HOST=${POSTGRES_HOST}
DB_PORT=${POSTGRES_PORT}

# Google OAuth (substitua pelos seus)
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Kafka Settings
KAFKA_KRAFT_MODE=true
KAFKA_PROCESS_ROLES=controller,broker
KAFKA_NODE_ID=1
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka_broker_1:29092
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:29092,EXTERNAL://0.0.0.0:29093
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka_broker_1:9092,EXTERNAL://localhost:29093
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_METADATA_MAX_IDLE_INTERVAL_MS=5000
KAFKA_METADATA_MAX_AGE_MS=3000
KAFKA_LOG_FLUSH_INTERVAL_MESSAGES=1
KAFKA_LOG_FLUSH_INTERVAL_MS=1000
CLUSTER_ID=change-me-to-a-random-cluster-id

# Kafka Settings - kafka_consumer
KAFKA_BROKER="kafka_broker_1:9092"
KAFKA_GROUP_ID="group1"
PYTHONUNBUFFERED="1"

# Kafka Settings - kafka_streaming
KAFKA_BROKER="kafka_broker_1:9092"
KAFKA_GROUP_ID="group2"
PYTHONUNBUFFERED="1"

# Clickhouse / Grafana
CLICKHOUSE_DB=production_data
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_INSTALL_PLUGINS=grafana-clickhouse-datasource
